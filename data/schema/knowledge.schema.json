{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spumy/knowledge.schema.json",
  "title": "Connaissances halieutiques SPUMY (phase 5)",
  "description": "Chaque connaissance porte son niveau de preuve (1 à 5), ses sources, ses limites et l'endroit du code qui l'utilise.",
  "type": "object",
  "additionalProperties": false,
  "required": ["titre", "version", "relu_le", "espece", "mode", "echelle", "regles", "connaissances", "regles_leurres"],
  "properties": {
    "titre": { "type": "string", "minLength": 10 },
    "version": { "type": "integer", "minimum": 1 },
    "relu_le": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "espece": { "enum": ["bar"] },
    "mode": { "enum": ["BORD", "BATEAU"] },
    "echelle": {
      "type": "object", "additionalProperties": false, "required": ["1", "2", "3", "4", "5"],
      "properties": {
        "1": { "type": "string", "minLength": 10 }, "2": { "type": "string", "minLength": 10 }, "3": { "type": "string", "minLength": 10 },
        "4": { "type": "string", "minLength": 10 }, "5": { "type": "string", "minLength": 10 }
      }
    },
    "regles": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } },
    "connaissances": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "domaine", "enonce", "utilise_par", "niveau", "sources", "limites", "verdict", "statut"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "domaine": { "enum": ["biologie", "comportement", "milieu", "alimentation", "leurres", "réglementation", "sécurité"] },
          "enonce": { "type": "string", "minLength": 10 },
          "utilise_par": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } },
          "niveau": { "type": "integer", "minimum": 1, "maximum": 5 },
          "sources": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["ref", "url", "niveau"],
              "properties": {
                "ref": { "type": "string", "minLength": 10 },
                "url": { "anyOf": [{ "type": "string", "pattern": "^https://" }, { "type": "null" }] },
                "niveau": { "type": "integer", "minimum": 1, "maximum": 5 }
              }
            }
          },
          "limites": { "type": "string", "minLength": 10 },
          "verdict": { "type": "string", "minLength": 5 },
          "statut": { "enum": ["VÉRIFIÉ", "INFÉRÉ", "HYPOTHÈSE", "INCONNU", "À DÉCIDER"] },
          "valeurs": {
            "type": "object", "additionalProperties": false, "required": ["texte", "niveau"],
            "properties": { "texte": { "type": "string", "minLength": 5 }, "niveau": { "type": "integer", "minimum": 1, "maximum": 5 } }
          }
        }
      }
    },
    "regles_leurres": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["niveau", "source", "regles"],
        "properties": {
          "niveau": { "type": "integer", "minimum": 1, "maximum": 5 },
          "source": { "type": "string", "minLength": 3 },
          "regles": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
